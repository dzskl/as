# =============================================================================
# Variáveis de ambiente do checkout.
# Local: copie para .env e rode `node --env-file=.env testes/servidor-local.js`
# Vercel: Project → Settings → Environment Variables (nunca commite valores reais)
# =============================================================================

# --- Modo do gateway -------------------------------------------------------
# simulado = nenhum pagamento real acontece, serve para testar o fluxo inteiro
# freepay   = usa a API real (só ligue depois de conferir o mapeamento em
#             api/_gateway.js contra a documentação oficial da FreePay)
GATEWAY_MODO=simulado

# --- URL pública do site ---------------------------------------------------
# Usada para montar a URL de webhook enviada ao gateway.
URL_SITE=https://seudominio.com.br

# --- Segredo do aplicativo -------------------------------------------------
# Assina o token que libera a página de obrigado. Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGREDO_APP=

# --- Credenciais da FreePay ------------------------------------------------
# A autenticação usa AS DUAS chaves: Basic base64("PUBLIC_KEY:SECRET_KEY").
# Ambas ficam no painel em Credenciais API.
FREEPAY_CHAVE_PUBLICA=
FREEPAY_CHAVE_SECRETA=

# Confirmados na documentação — só preencha para sobrescrever o padrão.
FREEPAY_URL_BASE=https://api.freepaybrasil.com/v1
FREEPAY_AUTH=basic
FREEPAY_CAMINHO_TRANSACAO=/payment-transaction/create

# Endpoint de consulta de transação: ainda não confirmado na documentação.
# Enquanto estiver vazio, o status vem apenas pelo webhook. Use :id no lugar
# do identificador, ex: /payment-transaction/:id
FREEPAY_CAMINHO_CONSULTA=

# Segredo e header da assinatura do webhook. Sem o segredo, nenhum webhook é
# aceito em produção — é o que impede alguém de liberar acesso de graça.
FREEPAY_WEBHOOK_SEGREDO=
FREEPAY_WEBHOOK_HEADER=x-signature

# --- Armazenamento dos pedidos ---------------------------------------------
# Redis via HTTP (Vercel KV / Upstash). Sem isso, os pedidos ficam em memória
# e sao perdidos a cada reinício da função — não use assim em produção.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Envio do e-mail de acesso (opcional) ----------------------------------
RESEND_API_KEY=
